---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/nav';

const layers = [
  {
    "n": "01",
    "title": "An envelope, not a favorite silhouette",
    "body": "Test height, lot coverage, setbacks, open space and allowed uses on actual parcels. Lay out accessible homes and circulation early. The best-looking massing may leave a difficult floor plate. Use the drawing-board lab to understand the area tradeoff, then replace it with real measurements."
  },
  {
    "n": "02",
    "title": "An integrated safety strategy",
    "body": "Compare permitted access and exit arrangements with fire and building specialists. Include travel distance, building height, occupancy, fire protection, rescue access and maintenance. A single-stair proposal is one possible research question, not the precondition for all courtyard housing."
  },
  {
    "n": "03",
    "title": "A transport plan",
    "body": "Assess daily travel, visitor access, deliveries, emergency access, accessible parking and bicycle storage. Model the area and operating consequences of the options. Reduced parking may be valuable, but no citywide claim here substitutes for current parcel-specific requirements."
  },
  {
    "n": "04",
    "title": "Land and neighbors",
    "body": "Identify owners, existing residents, businesses, easements and restrictions. Ask what public or community partners can contribute. Smaller parcels can allow variety; assembled sites can allow coordinated infrastructure. Neither ownership pattern guarantees a better neighborhood."
  },
  {
    "n": "05",
    "title": "Access as a design starting point",
    "body": "Include people with disabilities in the brief and in design review. Budget lifts and step-free shared spaces where needed, including their downtime and maintenance. Applicable accessibility rules are a floor for participation, not an inconvenience to design around."
  },
  {
    "n": "06",
    "title": "A viable operating story",
    "body": "Carry debt service, insurance, utilities, management, vacancy, repairs and replacement reserves through the model. Show the effect of overruns and interest-rate changes. Affordability means a cost a specified household can sustain, not merely a lower construction price."
  }
];

const beachheads = [
  {
    "name": "One parcel",
    "note": "A survey, existing-use record and dated zoning/code assessment."
  },
  {
    "name": "One household brief",
    "note": "Target incomes, access needs, home sizes and participation preferences."
  },
  {
    "name": "One honest model",
    "note": "Capital sources, operating costs, reserves and downside scenarios."
  }
];

const phases = [
  {
    "n": "Phase 1",
    "title": "Write the public benefit before the overlay",
    list: beachheads,
    "body": "Define who gains housing, what affordability means, how existing people are protected, and which shared spaces serve whom. Include measurable commitments. Make room for residents who will not or cannot attend every meeting."
  },
  {
    "n": "Phase 2",
    "title": "Compare several ways to deliver it",
    "body": "Study new construction, adaptive reuse and resident-led preservation. Use the same household needs and cost assumptions for each. Keep a record of why an option fails rather than treating every setback as an argument for a favored form.",
    "list": []
  },
  {
    "n": "Phase 3",
    "title": "Bring the right people around the table",
    "body": "Include residents, a capable development partner, planning and building staff, fire services, accessibility expertise, lenders and nearby businesses. Resolve disagreements with plans, evidence and documented constraints. The people who maintain a system deserve a say in its design.",
    "list": []
  },
  {
    "n": "Phase 4",
    "title": "Test a policy or a project, with conditions",
    "body": "If a rule is the bottleneck, describe it precisely and evaluate an alternative that retains safety and access. If funding is the bottleneck, identify who bears the risk. Proposed public land allocation needs transparent selection and local legal review, not a copied competition slogan.",
    "list": []
  },
  {
    "n": "Phase 5",
    "title": "Learn after people move in",
    "body": "Document costs, energy use, access, resident experience and maintenance over time, with consent. Compare results to promises and publish what changed. Replication should include the operating lessons and institutional support—not just the attractive elevations.",
    "list": []
  }
];
---

<Base
  title="The Plan — The Courtyard Block"
  description="A practical research and delivery sequence for courtyard housing: people, land, safety, access, finance and post-occupancy learning."
  current="plan"
>
  <header class="mx-auto max-w-[920px] px-6 pt-20 sm:px-12">
    <p class="mb-4 font-sans text-xs uppercase tracking-[0.22em] text-terracotta">The game plan</p>
    <h1 class="text-[clamp(40px,5.5vw,68px)] font-medium leading-[1.05] tracking-[-0.015em]">
      From nice sketch to real keys.
    </h1>
    <p class="mt-6 max-w-[65ch] text-[22px] leading-[1.55] text-ink/80">
      A building needs more than a yes from planning. This is a feasibility sequence for a group or city that wants to explore courtyard housing. Work through it iteratively; it is not a live legislative tracker or a promise of approval.
    </p>
  </header>

  <section class="mx-auto max-w-[920px] px-6 pt-14 sm:px-12">
    <h2 class="mb-2 text-[34px] font-medium">Six connected feasibility questions</h2>
    {
      layers.map((l) => (
        <article class="border-t border-ink/15 py-9 first-of-type:mt-6">
          <p class="font-sans text-sm text-terracotta">{l.n}</p>
          <h3 class="mt-2 text-[30px] font-medium">{l.title}</h3>
          <p class="mt-3.5 max-w-[65ch] text-[19px] leading-[1.6] text-ink/85">{l.body}</p>
        </article>
      ))
    }
  </section>

  <section class="mx-auto mt-16 max-w-[920px] px-6 sm:px-12">
    <div class="border-2 border-ink bg-paper-raised px-10 py-9">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">The pattern</p>
      <p class="mt-3.5 text-[21px] leading-[1.6]">
        A good feasibility study is allowed to say “this site does not work.” That answer can save years. Date each legal assumption and distinguish a proposed reform, an adopted rule and a permit for this particular project.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[920px] px-6 pt-22 sm:px-12">
    <h2 class="mb-2 text-[34px] font-medium">The game plan</h2>
    {
      phases.map((p) => (
        <article class="border-t border-ink/15 py-9 first-of-type:mt-6">
          <p class="font-sans text-sm text-terracotta">{p.n}</p>
          <h3 class="mt-2 text-[30px] font-medium">{p.title}</h3>
          <p class="mt-3.5 max-w-[65ch] text-[19px] leading-[1.6] text-ink/85">{p.body}</p>
          {p.list && (
            <div class="mt-6 grid">
              {p.list.map((c) => (
                <div class="grid grid-cols-1 gap-x-6 border-t border-ink/10 py-4 sm:grid-cols-[220px_1fr]">
                  <p class="pt-0.5 font-sans text-sm font-semibold uppercase tracking-[0.08em]">
                    {c.name}
                  </p>
                  <p class="text-[17.5px] leading-[1.6] text-ink/85">{c.note}</p>
                </div>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </section>

  <section class="mx-auto mt-18 max-w-[920px] px-6 sm:px-12">
    <blockquote class="border-t-2 border-b-2 border-ink py-10 text-[clamp(21px,2.4vw,26px)] leading-[1.5] italic">The drawing is the invitation. The operating budget, access plan and resident agreement are how the invitation stays open.</blockquote>
    <p class="mt-5 font-sans text-sm text-ink/60">
      Research starting points, reviewed October 2026: <a href="https://berkeleyca.gov/construction-development/permits-design-parameters/permit-types/zoning-permits">Berkeley’s permit process</a>, <a href="https://www.fire.ca.gov/about/resources/legislatively-mandated-reports">California’s single-exit/single-stairway report</a>, and <a href="https://www.hud.gov/sites/dfiles/FHEO/documents/TECHNICAL_OVERVIEW.pdf">HUD’s accessible multifamily design overview (PDF)</a>. Check the currently adopted requirements with the responsible jurisdiction before relying on a design.
    </p>
  </section>

  <section class="mx-auto mt-22 grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-6 px-6 sm:px-12">
    <a href={withBase('/berkeley/')} class="border-2 border-ink bg-paper-raised px-10 py-9 no-underline">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">Meanwhile</p>
      <p class="mt-2.5 text-[26px] font-medium leading-[1.25]">The Berkeley proposal →</p>
    </a>
    <a href={withBase('/how/')} class="border-2 border-ink bg-paper-raised px-10 py-9 no-underline">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">For a group</p>
      <p class="mt-2.5 text-[26px] font-medium leading-[1.25]">Tenure, money, code, first steps →</p>
    </a>
  </section>
</Base>
