---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/nav';

const cities = [
  {
    "name": "Berkeley",
    "anchor": "berkeley",
    "tag": "A local starting point",
    "exists": "Existing commercial streets and transit make useful places to begin looking. The Berkeley chapter sets out three delivery ideas without claiming a permitted site.",
    "lands": "Compare parcels along useful daily routes, then look at actual dimensions, current uses and who would be affected. Include preservation as well as new construction.",
    "obstacle": "Affordability, existing tenants, site constraints and the full cost of delivery. Treat neighbors as people with information to contribute, not an obstacle to outsmart.",
    "source": "https://berkeleyca.gov/construction-development/permits-design-parameters/permit-types/zoning-permits",
    "sourceLabel": "City permit guide"
  },
  {
    "name": "Oakland",
    "anchor": "oakland",
    "tag": "The local cousin",
    "exists": "Swan’s Market offers a built example of cohousing, affordable rentals and commercial uses in and around a historic market.",
    "lands": "Study an existing mixed-use place before sketching a replacement. Reuse could retain useful fabric; it needs a serious survey and a plan for existing residents and businesses.",
    "obstacle": "Coordination across uses, ownership and financing. The question is how a new investment can support people already in the neighborhood.",
    "source": "https://ebaldc.org/swans-market-an-act-of-faith/",
    "sourceLabel": "EBALDC’s project history"
  },
  {
    "name": "San Francisco",
    "anchor": "san-francisco",
    "tag": "Keep the neighbors, too",
    "exists": "The San Francisco Community Land Trust documents resident-led building preservation and community ownership. That is useful institutional experience alongside the city’s physical fabric.",
    "lands": "Compare infill ideas with acquiring or improving existing housing. Investigate how a shared yard or common room could serve current residents without removing homes.",
    "obstacle": "Entry costs, rehabilitation needs and ongoing stewardship. An unusually shaped parcel may be interesting; it is not automatically a bargain.",
    "source": "https://sfclt.org/",
    "sourceLabel": "San Francisco Community Land Trust"
  },
  {
    "name": "Los Angeles",
    "anchor": "los-angeles",
    "tag": "A court, then a connection",
    "exists": "Begin with the city’s courtyard and shared-landscape housing as a design reference. Look at thresholds, shade and how the paths meet the street.",
    "lands": "Compare a small court with a denser mixed-use version on a specific site. Walk the route to transit, groceries and school; useful destinations matter more than a transit symbol on a drawing.",
    "obstacle": "Evaluate heat, shade, accessible travel, air quality, noise and existing residents together. A nice internal garden cannot fix a difficult journey outside it.",
    "source": null,
    "sourceLabel": null
  },
  {
    "name": "New York",
    "anchor": "new-york",
    "tag": "Make the open space actually usable",
    "exists": "Use existing blocks as a field study: where does daylight reach, which courts are usable, and how do neighbors share a small piece of outside?",
    "lands": "Compare enclosed courts with open-sided arrangements, passages and shared terraces. Test usable outdoor space against household needs and the actual site envelope.",
    "obstacle": "Sunlight, overlooking, ventilation and affordability require separate investigation. Calling an airshaft a courtyard will not make it somewhere you want to sit.",
    "source": null,
    "sourceLabel": null
  },
  {
    "name": "Miami",
    "anchor": "miami",
    "tag": "Bring shade. Also, a drainage plan.",
    "exists": "A courtyard is an opportunity to explore shade and outdoor space. It does not automatically provide comfortable temperatures or useful ventilation in a humid climate.",
    "lands": "Model orientation, shade, wind, rain and indoor cooling together. Explore how an accessible street entrance connects to any raised living level.",
    "obstacle": "Flood exposure and required elevations must be assessed for the actual site and jurisdiction. Raised floors change access and street relationships; they do not dictate one universal design.",
    "source": "https://www.miamidade.gov/global/economy/building/flood-protection/elevation-certificates.page",
    "sourceLabel": "Miami-Dade elevation guidance"
  }
];

const lighter = [
  {
    "name": "Portland",
    "b": "Try the brief on a real parcel. Compare a smaller court with mid-rise, and ask how rain, seasonal light and accessible routes shape the shared space."
  },
  {
    "name": "Seattle",
    "b": "Study a sloping site: can a split-level court connect homes without making step-free access feel like a service route? Check local code with the design team."
  },
  {
    "name": "Chicago",
    "b": "Look closely at an existing courtyard building before designing a new one. Record the relationship among street, entry, planting and apartment windows."
  },
  {
    "name": "Boston",
    "b": "Test shared housing against smaller parcels, existing buildings and winter use. Which common rooms would people enjoy when the outdoor table is taking the season off?"
  },
  {
    "name": "Washington DC",
    "b": "Study how a proposed building meets an existing street wall. Then test the inside of the block: privacy, useful daylight and who can reach the shared garden."
  }
];
---

<Base title="Cities — The Courtyard Block" current="cities">
  <header class="mx-auto max-w-[920px] px-6 pt-20 sm:px-12">
    <p class="mb-4 font-sans text-xs uppercase tracking-[0.22em] text-terracotta">
      The pattern travels
    </p>
    <h1 class="text-[clamp(40px,5.5vw,68px)] font-medium leading-[1.05] tracking-[-0.015em]">
      Same idea. Different neighborhood.
    </h1>
    <p class="mt-6 max-w-[65ch] text-[22px] leading-[1.55] text-ink/80">
      A set of design prompts for eleven cities, not a ranking or current zoning guide. Start with local people, built examples and the actual parcel. The shape should adapt to the place.
    </p>
  </header>

  <section class="mx-auto mt-6 max-w-[1100px] px-6 sm:px-12">
    {
      cities.map((c) => (
        <article id={c.anchor} class="border-t border-ink/15 py-12">
          <div class="flex flex-wrap items-baseline justify-between gap-6">
            <h2 class="text-4xl font-medium">{c.name}</h2>
            <p class="font-sans text-xs uppercase tracking-[0.16em] text-moss">{c.tag}</p>
          </div>
          <div class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-5">
            <div>
              <p class="font-sans text-[11px] uppercase tracking-[0.16em] text-ink/50">Starting point</p>
              <p class="mt-2 text-[17.5px] leading-[1.6] text-ink/90">{c.exists}</p>
            </div>
            <div>
              <p class="font-sans text-[11px] uppercase tracking-[0.16em] text-ink/50">
                What to explore
              </p>
              <p class="mt-2 text-[17.5px] leading-[1.6] text-ink/90">{c.lands}</p>
            </div>
            <div>
              <p class="font-sans text-[11px] uppercase tracking-[0.16em] text-terracotta">
                Questions to resolve
              </p>
              <p class="mt-2 text-[17.5px] leading-[1.6] text-ink/90">{c.obstacle}</p>
              {c.source && <a class="source-link mt-3 block" href={c.source}>{c.sourceLabel} ↗</a>}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="mx-auto mt-14 max-w-[1100px] px-6 sm:px-12">
    <h2 class="mb-6 text-[30px] font-medium">Five more places to take a curious walk</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-px border border-ink/15 bg-ink/15">
      {
        lighter.map((l) => (
          <div class="bg-paper p-6">
            <h3 class="text-xl font-medium">{l.name}</h3>
            <p class="mt-2 text-[15.5px] leading-[1.55] text-ink/80">{l.b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-22 max-w-[1240px] px-6 sm:px-12">
    <a href={withBase('/how/')} class="block border-2 border-ink bg-paper-raised px-12 py-11 no-underline">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">Next</p>
      <p class="mt-3 text-[clamp(26px,3vw,38px)] font-medium leading-[1.2]">
        How to actually do it — tenure, money, code, first steps →
      </p>
    </a>
  </section>
</Base>
