const facts = [
  { k: 'City', v: 'Berlin-Kreuzberg' },
  { k: 'Year', v: '2013' },
  { k: 'Homes', v: '19' },
  { k: 'Architects', v: 'ifau + Jesko Fezer · Heide & von Beckerath' },
  { k: 'Tenure', v: 'Baugruppe' },
  { k: 'Signature', v: 'Continuous wraparound balcony' },
];

const gallery = [
  { placeholder: 'Wraparound balcony — photo needed', cap: 'The continuous exterior balcony' },
