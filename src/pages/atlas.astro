---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { buildings, filterChips, fabric } from '../data/buildings';
import { withBase } from '../lib/nav';
---

<Base title="Atlas — The Courtyard Block" current="atlas">
  <header class="mx-auto max-w-[1240px] px-6 pt-20 sm:px-12">
    <p class="mb-4 font-sans text-xs uppercase tracking-[0.22em] text-terracotta">The atlas</p>
    <h1 class="text-[clamp(40px,5.5vw,68px)] font-medium leading-[1.05] tracking-[-0.015em]">
      Buildings that already do this
    </h1>
    <p class="mt-6 max-w-[65ch] text-[21px] leading-[1.55] text-ink/80">
      Case studies from Barcelona to Oakland. Facts are drawn from each project's published
      record; approximate figures are marked. These are relatives, not identical twins: courtyard blocks, open clusters, retrofits, and a whole district. Borrow the useful questions.
    </p>
  </header>

  <div class="mx-auto mt-10 flex max-w-[1240px] flex-wrap gap-2.5 px-6 sm:px-12" id="filter-chips">
    {
      filterChips.map((chip) => (
        <button
          data-filter={chip}
          aria-pressed={chip === 'all'}
          aria-controls="atlas-grid"
          class:list={[
            'cursor-pointer rounded-full border px-4 py-2 font-sans text-[13px] uppercase tracking-[0.08em] transition-colors',
            chip === 'all'
              ? 'border-ink bg-ink text-paper'
              : 'border-ink/35 bg-transparent text-ink',
          ]}
        >
          {chip === 'all' ? 'All' : chip}
        </button>
      ))
    }
  </div>

  <p id="atlas-count" aria-live="polite" class="mx-auto max-w-[1240px] px-6 pt-5 font-sans text-sm sm:px-12">13 places to borrow an idea from.</p>
  <section
    class="mx-auto mt-9 grid max-w-[1240px] grid-cols-[repeat(auto-fill,minmax(min(100%,340px),1fr))] gap-x-7 gap-y-10 px-6 sm:px-12"
    id="atlas-grid"
  >
    {
      buildings.map((b) => (
        <article id={b.anchor} data-tags={b.tags.join('|')} class="flex flex-col">
          <div>
            <div class="h-[300px] w-full">
              <ImageSlot
                src={b.src}
                alt={b.name}
                placeholder={b.placeholder}
                credit={b.credit}
                creditHref={b.creditHref}
              />
            </div>
          </div>
          <div class="mt-3.5 flex flex-wrap items-baseline justify-between gap-2">
            <a href={withBase(`/${b.slug}/`)} class="no-underline">
              <h2 class="text-[25px] font-medium">{b.name}</h2>
            </a>
            <span class="font-sans text-xs uppercase tracking-[0.12em] text-ink/50">
              {b.meta}
            </span>
          </div>
          <p class="mt-2 text-[16.5px] leading-[1.55] text-ink/80">{b.blurb}</p>
          <p class="mt-2.5 font-sans text-xs uppercase tracking-[0.1em] text-moss">
            {b.tags.join(' · ')}
          </p>
          {b.full && (
            <a
              href={withBase(`/${b.slug}/`)}
              class="mt-2.5 font-sans text-[13px] uppercase tracking-[0.12em] text-terracotta no-underline"
            >
              Full case study →
            </a>
          )}
        </article>
      ))
    }
  </section>

  <section id="fabric" class="mx-auto mt-24 max-w-[1240px] px-6 sm:px-12">
    <h2 class="mb-2.5 text-[34px] font-medium">The anonymous fabric</h2>
    <p class="mb-8 max-w-[65ch] text-[19px] leading-[1.6] text-ink/80">
      Individual landmarks are only part of the story. These historic urban patterns give context; each has its own social history, ownership, and variation.
    </p>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-7">
      {
        fabric.map((f) => (
          <div>
            <div class="h-[220px] w-full">
              <ImageSlot
                src={f.src}
                alt={f.name}
                placeholder={f.placeholder}
                credit={f.credit}
                creditHref={f.creditHref}
              />
            </div>
            <h3 class="mt-3 text-xl font-medium">{f.name}</h3>
            <p class="mt-1.5 text-[15.5px] leading-[1.5] text-ink/75">{f.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-[1240px] px-6 sm:px-12">
    <a
      href={withBase('/why/')}
      class="block border-2 border-ink bg-paper-raised px-12 py-11 no-underline"
    >
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">Next</p>
      <p class="mt-3 text-[clamp(26px,3vw,38px)] font-medium leading-[1.2]">
        What makes this easier—or harder—to build in the US? →
      </p>
    </a>
  </section>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('#filter-chips button');
    const cards = document.querySelectorAll<HTMLElement>('#atlas-grid article');
    const active = ['border-ink', 'bg-ink', 'text-paper'];
    const inactive = ['border-ink/35', 'bg-transparent', 'text-ink'];

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.setAttribute('aria-pressed', String(on));
          c.classList.remove(...(on ? inactive : active));
          c.classList.add(...(on ? active : inactive));
        });
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? '').split('|');
          card.hidden = !(filter === 'all' || tags.includes(filter));
        });
        const count = [...cards].filter(card => !card.hidden).length;
        document.getElementById('atlas-count')!.textContent = `${count} ${count === 1 ? 'place' : 'places'} to explore${filter === 'all' ? '.' : ` · ${filter}`}`;
      });
    });
  </script>
</Base>
