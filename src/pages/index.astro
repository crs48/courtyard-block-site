---
import Base from '../layouts/Base.astro';
---

<Base>
  <main class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Courtyard Block</h1>
    <p class="mt-4 text-lg text-stone-600">
      The full site is on its way. In the meantime, you can follow along and
      contribute ideas on
      <a
        href="https://github.com/crs48/courtyardblock"
        class="font-medium text-stone-900 underline underline-offset-2"
      >GitHub</a>.
    </p>
  </main>
</Base>
