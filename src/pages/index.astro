---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { withBase } from '../lib/nav';

const rail = [
  {
    name: 'La Borda',
    meta: 'Barcelona · 2018 · co-op',
    href: '/la-borda/',
    placeholder: 'La Borda — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/La%20Borda%20building%20-%20front%20facade%201.jpg?width=1400',
    credit: 'via Wikimedia Commons',
    creditHref: 'https://commons.wikimedia.org/wiki/File:La_Borda_building_-_front_facade_1.jpg',
  },
  {
    name: 'Kalkbreite',
    meta: 'Zürich · 2014 · over a tram depot',
    href: '/kalkbreite/',
    placeholder: 'Kalkbreite — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Kalkbreite.jpg?width=1400',
    credit: 'Bub37 · CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Kalkbreite.jpg',
  },
  {
    name: 'Spreefeld',
    meta: 'Berlin · 2014 · on the river',
    href: '/spreefeld/',
    placeholder: 'Spreefeld — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Mitte%20Wilhelmine-Gemberg-Weg-001.jpg?width=1400',
    credit: 'Fridolin freudenfett · CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Mitte_Wilhelmine-Gemberg-Weg-001.jpg',
  },
  { name: 'R50', meta: 'Berlin-Kreuzberg · 2013', href: '/r50/', placeholder: 'R50 — photo needed' },
  {
    name: 'Sargfabrik',
    meta: 'Vienna · 1996 · factory reuse',
    href: '/sargfabrik/',
    placeholder: 'Sargfabrik — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Wien-Penzing%20-%20Wohn-%20und%20Kulturprojekt%20Sargfabrik%20-%2010%20-%20Dachgarten.jpg?width=1400',
    credit: 'Haeferl · CC BY-SA 3.0',
    creditHref:
      'https://commons.wikimedia.org/wiki/File:Wien-Penzing_-_Wohn-_und_Kulturprojekt_Sargfabrik_-_10_-_Dachgarten.jpg',
  },
  { name: 'Brutopia', meta: 'Brussels · 2015', href: '/brutopia/', placeholder: 'Brutopia — photo needed' },
  { name: 'Bijgaardehof', meta: 'Ghent · factory reuse', href: '/bijgaardehof/', placeholder: 'Bijgaardehof — photo needed' },
  {
    name: "Swan's Market",
    meta: 'Oakland · 2000',
    href: '/swans-market/',
    placeholder: "Swan's Market — photo needed",
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/10th%20Street%20Market%2C%20Oakland%2C%20CA%2C%20at%20sunset.jpg?width=1400',
    credit: 'Dreamyshade · CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:10th_Street_Market,_Oakland,_CA,_at_sunset.jpg',
  },
  {
    name: 'Vauban',
    meta: 'Freiburg · a whole district',
    href: '/vauban/',
    placeholder: 'Vauban — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Freiburg%20-%20Vauban.jpg?width=1400',
    credit: 'via Wikimedia Commons',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Freiburg_-_Vauban.jpg',
  },
  {
    name: 'Eixample fabric',
    meta: 'Barcelona · the anonymous block',
    href: '/atlas/#fabric',
    placeholder: 'Eixample — photo needed',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Aerial%20view%20of%20Barcelona%2C%20Spain%20%2851227309370%29.jpg?width=1400',
    credit: 'dronepicr · CC BY 2.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Aerial_view_of_Barcelona,_Spain_(51227309370).jpg',
  },
];

const brief = [
  { k: 'Height', v: '5–7 stories' },
  { k: 'Street', v: 'Ground-floor retail at the sidewalk' },
  { k: 'Middle', v: 'Inner courtyard, 40–80 ft across' },
  { k: 'Roof', v: 'A second courtyard — greenhouse, play, PV' },
  { k: 'Homes', v: '25–80' },
  { k: 'Tenure', v: 'Limited-equity co-op or CLT' },
];
---

<Base title="The Courtyard Block" current="home">
  <header class="mx-auto max-w-[1240px] px-6 pt-18 sm:px-12">
    <p class="mb-4.5 font-sans text-xs uppercase tracking-[0.22em] text-terracotta">
      An atlas &amp; a proposal
    </p>
    <h1 class="max-w-[900px] text-[clamp(48px,7vw,92px)] font-medium leading-[1.02] tracking-[-0.02em]">
      The Courtyard Block
    </h1>
    <p class="mt-5 text-[clamp(20px,2.4vw,28px)] italic text-ink/75">
      European mid-rise living, starting in Berkeley.
    </p>
  </header>

  <figure class="mx-auto mt-14 max-w-[1240px] px-6 sm:px-12">
    <svg
      viewBox="0 0 1200 420"
      class="block h-auto w-full"
      role="img"
      aria-label="Section through a courtyard block: tram street, shops, six floors of homes, a shared courtyard, roof garden"
    >
      <line x1="0" y1="360" x2="1200" y2="360" stroke="#1c1915" stroke-width="2.5"></line>
      <rect x="30" y="322" width="96" height="34" rx="6" fill="none" stroke="#1c1915" stroke-width="2"></rect>
      <line x1="46" y1="326" x2="46" y2="352" stroke="#1c1915" stroke-width="1.2"></line><line x1="110" y1="326" x2="110" y2="352" stroke="#1c1915" stroke-width="1.2"></line>
      <circle cx="52" cy="360" r="5" fill="#1c1915"></circle><circle cx="104" cy="360" r="5" fill="#1c1915"></circle>
      <line x1="78" y1="322" x2="78" y2="304" stroke="#1c1915" stroke-width="1.5"></line><line x1="62" y1="304" x2="94" y2="304" stroke="#1c1915" stroke-width="1.5"></line>
      <line x1="0" y1="300" x2="1200" y2="300" stroke="rgba(28,25,21,0.25)" stroke-width="1" stroke-dasharray="2 6"></line>
      <line x1="176" y1="360" x2="176" y2="352" stroke="#1c1915" stroke-width="2"></line>
      <g stroke="#3f5c45" stroke-width="2" fill="none">
        <line x1="216" y1="360" x2="216" y2="300"></line>
        <path d="M216 300 C 196 296, 190 274, 204 262 C 194 244, 210 226, 228 232 C 238 218, 262 222, 266 240 C 282 244, 284 266, 270 276 C 278 292, 258 304, 216 300 Z"></path>
      </g>
      <text x="146" y="392" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">TRAM · SIDEWALK AS A ROOM</text>
      <g fill="none" stroke="#1c1915" stroke-width="2.5">
        <rect x="330" y="88" width="180" height="272"></rect>
        <rect x="330" y="292" width="180" height="68" fill="rgba(180,74,47,0.12)"></rect>
      </g>
      <g stroke="#1c1915" stroke-width="1.5">
        <line x1="330" y1="252" x2="510" y2="252"></line><line x1="330" y1="212" x2="510" y2="212"></line><line x1="330" y1="172" x2="510" y2="172"></line><line x1="330" y1="132" x2="510" y2="132"></line>
      </g>
      <g fill="rgba(28,25,21,0.14)">
        <rect x="346" y="140" width="20" height="24"></rect><rect x="386" y="140" width="20" height="24"></rect><rect x="426" y="140" width="20" height="24"></rect><rect x="466" y="140" width="20" height="24"></rect>
        <rect x="346" y="180" width="20" height="24"></rect><rect x="386" y="180" width="20" height="24"></rect><rect x="426" y="180" width="20" height="24"></rect><rect x="466" y="180" width="20" height="24"></rect>
        <rect x="346" y="220" width="20" height="24"></rect><rect x="386" y="220" width="20" height="24"></rect><rect x="426" y="220" width="20" height="24"></rect><rect x="466" y="220" width="20" height="24"></rect>
        <rect x="346" y="100" width="20" height="24"></rect><rect x="386" y="100" width="20" height="24"></rect><rect x="426" y="100" width="20" height="24"></rect><rect x="466" y="100" width="20" height="24"></rect>
      </g>
      <g fill="none" stroke="#b44a2f" stroke-width="2">
        <rect x="344" y="306" width="34" height="54"></rect><rect x="394" y="306" width="34" height="54"></rect><rect x="444" y="306" width="34" height="54"></rect>
      </g>
      <text x="352" y="286" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#b44a2f">SHOPS, 16 FT CEILINGS</text>
      <g fill="none" stroke="#1c1915" stroke-width="2">
        <path d="M330 88 L 348 64 L 510 64 L 510 88"></path>
        <rect x="420" y="40" width="70" height="24"></rect>
        <line x1="420" y1="52" x2="490" y2="52" stroke-width="1"></line><line x1="437" y1="40" x2="437" y2="64" stroke-width="1"></line><line x1="455" y1="40" x2="455" y2="64" stroke-width="1"></line><line x1="472" y1="40" x2="472" y2="64" stroke-width="1"></line>
      </g>
      <text x="356" y="34" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">ROOF: GREENHOUSE + PV</text>
      <g stroke="#1c1915" stroke-width="1.5" fill="none">
        <line x1="510" y1="132" x2="540" y2="132"></line><line x1="510" y1="172" x2="540" y2="172"></line><line x1="510" y1="212" x2="540" y2="212"></line><line x1="510" y1="252" x2="540" y2="252"></line>
        <line x1="540" y1="132" x2="540" y2="120"></line><line x1="540" y1="172" x2="540" y2="160"></line><line x1="540" y1="212" x2="540" y2="200"></line><line x1="540" y1="252" x2="540" y2="240"></line>
      </g>
      <text x="524" y="106" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">GALLERIES</text>
      <g stroke="#3f5c45" stroke-width="2" fill="none">
        <line x1="600" y1="360" x2="600" y2="316"></line>
        <path d="M600 316 C 584 312, 580 294, 592 285 C 584 270, 597 256, 611 261 C 619 250, 638 253, 641 267 C 654 271, 655 288, 644 296 C 650 308, 634 318, 600 316 Z"></path>
        <line x1="700" y1="360" x2="700" y2="322"></line>
        <path d="M700 322 C 686 318, 683 303, 693 296 C 686 283, 697 271, 709 275 C 716 266, 732 269, 734 281 C 745 284, 746 298, 737 305 C 742 315, 728 323, 700 322 Z"></path>
      </g>
      <g stroke="#1c1915" stroke-width="1.5" fill="none">
        <rect x="646" y="336" width="52" height="16"></rect><line x1="654" y1="352" x2="654" y2="360"></line><line x1="690" y1="352" x2="690" y2="360"></line>
      </g>
      <text x="574" y="392" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#3f5c45">THE HOF — GARDEN · PLAY · DINNER</text>
      <g fill="none" stroke="#1c1915" stroke-width="2.5">
        <rect x="790" y="112" width="150" height="248"></rect>
      </g>
      <g stroke="#1c1915" stroke-width="1.5">
        <line x1="790" y1="300" x2="940" y2="300"></line><line x1="790" y1="252" x2="940" y2="252"></line><line x1="790" y1="212" x2="940" y2="212"></line><line x1="790" y1="172" x2="940" y2="172"></line><line x1="790" y1="132" x2="940" y2="132"></line>
      </g>
      <g fill="rgba(28,25,21,0.14)">
        <rect x="806" y="140" width="18" height="22"></rect><rect x="842" y="140" width="18" height="22"></rect><rect x="878" y="140" width="18" height="22"></rect><rect x="912" y="140" width="18" height="22"></rect>
        <rect x="806" y="180" width="18" height="22"></rect><rect x="842" y="180" width="18" height="22"></rect><rect x="878" y="180" width="18" height="22"></rect><rect x="912" y="180" width="18" height="22"></rect>
        <rect x="806" y="220" width="18" height="22"></rect><rect x="842" y="220" width="18" height="22"></rect><rect x="878" y="220" width="18" height="22"></rect><rect x="912" y="220" width="18" height="22"></rect>
        <rect x="806" y="310" width="18" height="22"></rect><rect x="842" y="310" width="18" height="22"></rect><rect x="878" y="310" width="18" height="22"></rect><rect x="912" y="310" width="18" height="22"></rect>
      </g>
      <g stroke="#1c1915" stroke-width="1.5" fill="none">
        <line x1="790" y1="132" x2="760" y2="132"></line><line x1="790" y1="172" x2="760" y2="172"></line><line x1="790" y1="212" x2="760" y2="212"></line><line x1="790" y1="252" x2="760" y2="252"></line>
        <line x1="760" y1="132" x2="760" y2="120"></line><line x1="760" y1="172" x2="760" y2="160"></line><line x1="760" y1="212" x2="760" y2="200"></line><line x1="760" y1="252" x2="760" y2="240"></line>
      </g>
      <g fill="none" stroke="#1c1915" stroke-width="2">
        <path d="M790 112 L 806 92 L 940 92 L 940 112"></path>
        <rect x="820" y="72" width="60" height="20"></rect><line x1="820" y1="82" x2="880" y2="82" stroke-width="1"></line><line x1="835" y1="72" x2="835" y2="92" stroke-width="1"></line><line x1="850" y1="72" x2="850" y2="92" stroke-width="1"></line><line x1="865" y1="72" x2="865" y2="92" stroke-width="1"></line>
      </g>
      <text x="806" y="62" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">REAR WING</text>
      <g stroke="#3f5c45" stroke-width="2" fill="none">
        <line x1="1030" y1="360" x2="1030" y2="306"></line>
        <path d="M1030 306 C 1012 302, 1007 282, 1020 271 C 1011 255, 1025 239, 1041 245 C 1050 232, 1071 236, 1075 252 C 1089 256, 1091 275, 1078 284 C 1085 298, 1067 310, 1030 306 Z"></path>
      </g>
      <text x="990" y="392" font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">GARDEN COURT BEYOND</text>
      <g font-family="'Source Sans 3',sans-serif" font-size="13" letter-spacing="2.2" fill="#1c1915">
        <text x="336" y="392">STREET WALL, 5–7 STORIES</text>
      </g>
    </svg>
    <figcaption class="mt-3.5 font-sans text-xs uppercase tracking-[0.16em] text-ink/55">
      Fig. 01 — Section through the type. Illustrative.
    </figcaption>
  </figure>

  <section class="mx-auto max-w-[720px] px-6 pt-18 sm:px-12">
    <p class="text-2xl leading-[1.55]">
      Most American cities offer two shapes of home: a house with a driveway, or a tower with a
      garage. The everyday European city is a third thing — five to seven stories, shops on the
      ground floor, a private courtyard in the middle, a tram or a wide sidewalk out front. People
      live above the bakery. Children play in the Hof. The roof is a garden.
    </p>
    <p class="mt-6 text-2xl leading-[1.55]">
      This site is an atlas of that building, and a proposal to start one in Berkeley.
    </p>
  </section>

  <section class="pt-22">
    <div class="mx-auto flex max-w-[1240px] items-baseline justify-between px-6 sm:px-12">
      <h2 class="text-[34px] font-medium">The buildings already exist</h2>
      <a
        href={withBase('/atlas/')}
        class="font-sans text-[13px] uppercase tracking-[0.14em] text-terracotta no-underline"
      >
        Open the atlas →
      </a>
    </div>
    <div class="flex gap-5 overflow-x-auto px-6 pt-8 pb-3 sm:px-12 [scrollbar-width:thin]">
      {
        rail.map((b) => (
          <a href={withBase(b.href)} class="w-[280px] flex-none no-underline">
            <div class="h-[360px] w-[280px]">
              <ImageSlot
                src={b.src}
                alt={b.name}
                placeholder={b.placeholder}
                credit={b.credit}
                creditHref={b.creditHref}
              />
            </div>
            <p class="mt-3 mb-0.5 text-xl font-medium">{b.name}</p>
            <p class="font-sans text-xs uppercase tracking-[0.14em] text-ink/55">{b.meta}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pt-24 sm:px-12">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] border-t border-ink/20">
      <a href={withBase('/atlas/')} class="border-r border-ink/10 py-8 pr-8 pb-10 no-underline">
        <p class="font-sans text-[15px] text-terracotta">01</p>
        <h3 class="mt-2.5 mb-2 text-[26px] font-medium">See it</h3>
        <p class="text-[17px] leading-[1.5] text-ink/75">
          Eleven-plus buildings, from Barcelona co-ops to a Zurich block over a tram depot, that
          already run this life as ordinary city.
        </p>
      </a>
      <a href={withBase('/why/')} class="border-r border-ink/10 p-8 pb-10 no-underline">
        <p class="font-sans text-[15px] text-terracotta">02</p>
        <h3 class="mt-2.5 mb-2 text-[26px] font-medium">Understand why it is rare here</h3>
        <p class="text-[17px] leading-[1.5] text-ink/75">
          Zoning, parking, egress code, and finance quietly made the European default block illegal
          — not impossible.
        </p>
      </a>
      <a href={withBase('/berkeley/')} class="py-8 pl-8 pb-10 no-underline">
        <p class="font-sans text-[15px] text-terracotta">03</p>
        <h3 class="mt-2.5 mb-2 text-[26px] font-medium">Propose it in Berkeley</h3>
        <p class="text-[17px] leading-[1.5] text-ink/75">
          A concrete brief, three site scenarios, and a first-year path for a founding group of
          households.
        </p>
      </a>
    </div>
  </section>

  <section
    class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(320px,1fr))] items-start gap-12 px-6 pt-24 sm:px-12"
  >
    <div class="border-2 border-ink bg-paper-raised px-9 pt-9 pb-10">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">The brief</p>
      <div class="mt-4.5 grid">
        {
          brief.map((row) => (
            <div class="flex justify-between gap-4 border-b border-ink/10 py-3">
              <span class="flex-none pt-0.5 font-sans text-[13px] uppercase tracking-[0.1em] text-ink/55">
                {row.k}
              </span>
              <span class="text-right text-lg">{row.v}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div>
      <h2 class="mb-2 text-[34px] font-medium">One, two, three, a block</h2>
      <p class="mb-7 text-lg leading-[1.55] text-ink/75">
        The replication unit is one building. Then the pattern repeats — the way Berlin and Vienna
        were actually made.
      </p>
      <a href={withBase('/scale/')} class="grid grid-cols-3 gap-4 no-underline">
        <div>
          <svg viewBox="0 0 120 100" class="h-auto w-full"><rect x="34" y="30" width="52" height="52" fill="none" stroke="#1c1915" stroke-width="2.5"></rect><rect x="48" y="44" width="24" height="24" fill="rgba(63,92,69,0.35)" stroke="#3f5c45" stroke-width="1.5"></rect></svg>
          <p class="mt-1.5 text-center font-sans text-[11px] uppercase tracking-[0.16em] text-ink/60">One building</p>
        </div>
        <div>
          <svg viewBox="0 0 120 100" class="h-auto w-full"><rect x="14" y="30" width="44" height="52" fill="none" stroke="#1c1915" stroke-width="2.5"></rect><rect x="62" y="30" width="44" height="52" fill="none" stroke="#1c1915" stroke-width="2.5"></rect><rect x="42" y="46" width="36" height="22" fill="rgba(63,92,69,0.35)" stroke="#3f5c45" stroke-width="1.5"></rect></svg>
          <p class="mt-1.5 text-center font-sans text-[11px] uppercase tracking-[0.16em] text-ink/60">Two, shared Hof</p>
        </div>
        <div>
          <svg viewBox="0 0 120 100" class="h-auto w-full"><path d="M20 82 L20 30 L100 30 L100 82 L76 82 L76 54 L44 54 L44 82 Z" fill="none" stroke="#1c1915" stroke-width="2.5"></path><rect x="48" y="60" width="24" height="18" fill="rgba(63,92,69,0.35)" stroke="#3f5c45" stroke-width="1.5"></rect></svg>
          <p class="mt-1.5 text-center font-sans text-[11px] uppercase tracking-[0.16em] text-ink/60">Three, a court</p>
        </div>
      </a>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-[1240px] px-6 sm:px-12">
    <a href={withBase('/berkeley/')} class="block bg-ink px-12 py-16 text-paper no-underline hover:text-paper">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-[#e08b6d]">The proposal</p>
      <p class="mt-3.5 text-[clamp(30px,4vw,48px)] font-medium leading-[1.15] text-paper">
        Read the Berkeley proposal — the brief, the corridors, and three ways to start. →
      </p>
    </a>
  </section>
</Base>
