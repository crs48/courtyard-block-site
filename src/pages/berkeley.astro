---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/nav';

const legal = [
  {
    k: 'Downtown C-DMU',
    v: "Berkeley's downtown mixed-use zoning already contemplates mid-rise mixed use — commonly in the ~50–75 ft range, with limited taller exceptions. That is the 5–7 story band. The type is closest to legal here.",
  },
  {
    k: 'The corridors',
    v: 'University, San Pablo, Telegraph, Shattuck, Fourth: the natural street-wall locations, already commercial at the ground floor, already on frequent transit.',
  },
  {
    k: 'West Berkeley',
    v: 'The warehouses are tempting for Sargfabrik-style reuse, but MU-R height limits are much lower (~3 stories). Treat reuse there as a shorter cousin unless a variance or upzone exists.',
  },
  {
    k: 'Middle Housing reforms',
    v: 'Recent reforms help courtyard apartments in residential fabric — genuinely useful, but usually at a smaller scale than the European block. This proposal is honest about that gap.',
  },
];

const spec = [
  { k: 'Site', v: 'On or just off a commercial street' },
  { k: 'Height', v: '5–7 stories, street wall at the sidewalk' },
  { k: 'Ground floor', v: 'Shops, 15–18 ft ceilings' },
  { k: 'Courtyard', v: '~40–80 ft across — not a light well' },
  { k: 'Access', v: 'Single-loaded galleries on the courtyard' },
  { k: 'Common', v: 'Kitchen opening onto the Hof; guest rooms, laundry, workshop' },
  { k: 'Roof', v: 'Greenhouse + play + long table + PV' },
  { k: 'Homes', v: '25–60 on a first lot; ~80–100 if Kalkbreite-large' },
  { k: 'Parking', v: 'Underground or off-site — never in the courtyard' },
  { k: 'Tenure', v: 'Limited-equity co-op and/or community land trust' },
  { k: 'Retail leases', v: 'Member and neighborhood businesses' },
  { k: 'Method', v: 'New build, reuse, or recode — new courtyard block is the ideal' },
];

const year = [
  { n: '01', t: 'Gather 8–15 committed households. Not more; not a mailing list — households.' },
  {
    n: '02',
    t: 'Write the charter: money, exit, kids, cars, conflict, commerce. The hard conversations before the expensive ones.',
  },
  {
    n: '03',
    t: 'Join or form the wrapper: a community land trust or an existing trust, plus a development co-op.',
  },
  {
    n: '04',
    t: 'Walk every mixed-use parcel on the corridors. Map the deep lots, the tired walk-ups, the big roofs. Talk to owners before brokers.',
  },
  {
    n: '05',
    t: 'Commission the feasibility test on the best three candidates — and only then talk about buying anything.',
  },
];
---

<Base title="Berkeley — The Courtyard Block" current="berkeley">
  <header class="mx-auto max-w-[920px] px-6 pt-20 sm:px-12">
    <p class="mb-4 font-sans text-xs uppercase tracking-[0.22em] text-terracotta">The proposal</p>
    <h1 class="text-[clamp(40px,5.5vw,68px)] font-medium leading-[1.05] tracking-[-0.015em]">
      Berkeley first
    </h1>
    <p class="mt-6 max-w-[65ch] text-[22px] leading-[1.55] text-ink/80">
      A university town with BART, real commercial corridors, a downtown zoned for mid-rise, and a
      political appetite for housing. Also: expensive land and neighbors who fight height. A fair
      first test.
    </p>
  </header>

  <section class="mx-auto max-w-[920px] px-6 pt-16 sm:px-12">
    <h2 class="mb-3 text-[34px] font-medium">Where it fits — in rough legal terms</h2>
    <p class="mb-2 font-sans text-[13px] uppercase tracking-[0.12em] text-ink/50">
      A summary of public zoning documents, not legal advice
    </p>
    <div class="mt-6 grid">
      {
        legal.map((l) => (
          <div class="grid grid-cols-1 gap-6 border-t border-ink/15 py-5.5 sm:grid-cols-[200px_1fr]">
            <p class="pt-1 font-sans text-sm font-semibold uppercase tracking-[0.08em]">{l.k}</p>
            <p class="text-lg leading-[1.6] text-ink/85">{l.v}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-[1240px] px-6 sm:px-12">
    <div class="border-2 border-ink bg-paper-raised px-12 py-11">
      <div class="flex flex-wrap items-baseline justify-between gap-6">
        <h2 class="text-4xl font-medium">The Berkeley prototype brief</h2>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-terracotta">
          Specification · draft 01
        </p>
      </div>
      <div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-x-12">
        {
          spec.map((s) => (
            <div class="flex justify-between gap-4 border-b border-ink/10 py-3.5">
              <span class="flex-none pt-1 font-sans text-xs uppercase tracking-[0.1em] text-ink/55">
                {s.k}
              </span>
              <span class="text-right text-[17.5px]">{s.v}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-[1240px] px-6 sm:px-12">
    <h2 class="mb-2.5 text-[34px] font-medium">Three ways to start</h2>
    <p class="mb-10 max-w-[65ch] text-[19px] leading-[1.6] text-ink/80">
      Every drawing below is illustrative — a diagram of a method, not a real site.
    </p>

    <article class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] items-center gap-10 border-t border-ink/15 py-10">
      <div>
        <p class="font-sans text-sm text-terracotta">Scenario 1</p>
        <h3 class="mt-2 text-[28px] font-medium">New block on a corridor</h3>
        <p class="mt-3 text-lg leading-[1.6] text-ink/85">
          University, San Pablo, Telegraph, Shattuck, or downtown proper. A deep lot or an assembled
          pair, built to the sidewalk with shops below and a real Hof behind. The full brief — La
          Borda's section on a Berkeley corridor. Slowest and most expensive; also the truest.
        </p>
      </div>
      <figure>
        <svg viewBox="0 0 520 300" class="h-auto w-full" role="img" aria-label="Illustrative section: new corridor block">
          <line x1="10" y1="250" x2="510" y2="250" stroke="#1c1915" stroke-width="2.5"></line>
          <rect x="120" y="60" width="130" height="190" fill="none" stroke="#1c1915" stroke-width="2.5"></rect>
          <rect x="120" y="204" width="130" height="46" fill="rgba(180,74,47,0.14)" stroke="#1c1915" stroke-width="2"></rect>
          <g stroke="#1c1915" stroke-width="1.3"><line x1="120" y1="170" x2="250" y2="170"></line><line x1="120" y1="134" x2="250" y2="134"></line><line x1="120" y1="98" x2="250" y2="98"></line></g>
          <rect x="360" y="120" width="100" height="130" fill="none" stroke="#1c1915" stroke-width="2.5"></rect>
          <g stroke="#3f5c45" stroke-width="2" fill="none">
            <line x1="300" y1="250" x2="300" y2="212"></line>
            <path d="M300 212 C 286 208, 283 192, 293 185 C 286 172, 297 160, 309 164 C 316 155, 332 158, 334 170 C 345 173, 346 187, 337 194 C 342 204, 328 213, 300 212 Z"></path>
          </g>
          <g fill="none" stroke="#1c1915" stroke-width="2"><rect x="40" y="216" width="56" height="24" rx="4"></rect><circle cx="52" cy="250" r="4" fill="#1c1915"></circle><circle cx="84" cy="250" r="4" fill="#1c1915"></circle></g>
          <g font-family="'Source Sans 3',sans-serif" font-size="11" letter-spacing="1.6" fill="#1c1915">
            <text x="30" y="278">BUS · CORRIDOR</text>
            <text x="124" y="278" fill="#b44a2f">SHOPS + 5–7 STORIES</text>
            <text x="278" y="278" fill="#3f5c45">NEW HOF</text>
            <text x="364" y="278">EXISTING NEIGHBOR</text>
            <text x="376" y="40" fill="rgba(28,25,21,0.5)">ILLUSTRATIVE</text>
          </g>
        </svg>
      </figure>
    </article>

    <article class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] items-center gap-10 border-t border-ink/15 py-10">
      <div>
        <p class="font-sans text-sm text-terracotta">Scenario 2</p>
        <h3 class="mt-2 text-[28px] font-medium">Warehouse or market reuse</h3>
        <p class="mt-3 text-lg leading-[1.6] text-ink/85">
          The Sargfabrik and Swan's Market method: buy a big roof in West Berkeley or a deep
          commercial parcel, carve courtyards out of it, wrap homes around them. Honest caveat: West
          Berkeley's MU-R zoning tops out much lower (~3 stories), so reuse there is a shorter
          cousin of the brief unless a rezone or variance opens the band.
        </p>
      </div>
      <figure>
        <svg viewBox="0 0 520 300" class="h-auto w-full" role="img" aria-label="Illustrative section: warehouse reuse with carved courtyard">
          <line x1="10" y1="250" x2="510" y2="250" stroke="#1c1915" stroke-width="2.5"></line>
          <path d="M60 250 L60 140 L130 100 L200 140 L200 250" fill="none" stroke="#1c1915" stroke-width="2.5"></path>
          <path d="M320 250 L320 140 L390 100 L460 140 L460 250" fill="none" stroke="#1c1915" stroke-width="2.5"></path>
          <path d="M200 250 L200 140 L260 106" fill="none" stroke="rgba(28,25,21,0.3)" stroke-width="2" stroke-dasharray="5 5"></path>
          <path d="M320 250 L320 140 L260 106" fill="none" stroke="rgba(28,25,21,0.3)" stroke-width="2" stroke-dasharray="5 5"></path>
          <g stroke="#1c1915" stroke-width="1.3"><line x1="60" y1="180" x2="200" y2="180"></line><line x1="60" y1="215" x2="200" y2="215"></line><line x1="320" y1="180" x2="460" y2="180"></line><line x1="320" y1="215" x2="460" y2="215"></line></g>
          <g stroke="#3f5c45" stroke-width="2" fill="none">
            <line x1="260" y1="250" x2="260" y2="216"></line>
            <path d="M260 216 C 247 212, 244 197, 253 190 C 247 178, 257 167, 268 171 C 274 163, 289 165, 291 176 C 301 179, 302 192, 294 198 C 299 208, 285 217, 260 216 Z"></path>
          </g>
          <g font-family="'Source Sans 3',sans-serif" font-size="11" letter-spacing="1.6" fill="#1c1915">
            <text x="66" y="278">HOMES IN THE SHED</text>
            <text x="222" y="278" fill="#3f5c45">ROOF REMOVED → HOF</text>
            <text x="396" y="278">WORKSHOPS KEPT</text>
            <text x="376" y="40" fill="rgba(28,25,21,0.5)">ILLUSTRATIVE</text>
          </g>
        </svg>
      </figure>
    </article>

    <article class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] items-center gap-10 border-t border-b border-ink/15 py-10">
      <div>
        <p class="font-sans text-sm text-terracotta">Scenario 3</p>
        <h3 class="mt-2 text-[28px] font-medium">Recode an existing apartment house</h3>
        <p class="mt-3 text-lg leading-[1.6] text-ink/85">
          Buy a tired walk-up. Make the backyard a real Hof — dig out the parking, plant it, put the
          long table in. Turn a ground-floor unit into the common kitchen; a storage room into the
          workshop. Smaller and not seven stories, but a co-op can do it in two years, and it
          teaches the group everything the big version needs.
        </p>
      </div>
      <figure>
        <svg viewBox="0 0 520 300" class="h-auto w-full" role="img" aria-label="Illustrative section: existing walk-up recoded with courtyard and common kitchen">
          <line x1="10" y1="250" x2="510" y2="250" stroke="#1c1915" stroke-width="2.5"></line>
          <rect x="90" y="120" width="150" height="130" fill="none" stroke="#1c1915" stroke-width="2.5"></rect>
          <g stroke="#1c1915" stroke-width="1.3"><line x1="90" y1="163" x2="240" y2="163"></line><line x1="90" y1="206" x2="240" y2="206"></line></g>
          <rect x="94" y="210" width="70" height="40" fill="rgba(180,74,47,0.18)" stroke="#b44a2f" stroke-width="2"></rect>
          <g stroke="#3f5c45" stroke-width="2" fill="none">
            <line x1="320" y1="250" x2="320" y2="206"></line>
            <path d="M320 206 C 305 202, 301 185, 312 176 C 305 162, 317 149, 330 154 C 337 144, 355 147, 358 160 C 369 163, 371 178, 361 185 C 367 196, 351 207, 320 206 Z"></path>
            <rect x="396" y="230" width="60" height="20"></rect>
          </g>
          <g font-family="'Source Sans 3',sans-serif" font-size="11" letter-spacing="1.6" fill="#1c1915">
            <text x="94" y="278">EXISTING WALK-UP</text>
            <text x="96" y="236" fill="#b44a2f">COMMON KITCHEN</text>
            <text x="290" y="278" fill="#3f5c45">PARKING OUT, HOF IN</text>
            <text x="398" y="278" fill="#3f5c45">LONG TABLE</text>
            <text x="376" y="40" fill="rgba(28,25,21,0.5)">ILLUSTRATIVE</text>
          </g>
        </svg>
      </figure>
    </article>
  </section>

  <section class="mx-auto mt-22 max-w-[920px] px-6 sm:px-12">
    <h2 class="mb-6 text-[34px] font-medium">The first year — before any land</h2>
    <div class="grid">
      {
        year.map((y) => (
          <div class="grid grid-cols-[64px_1fr] gap-5 border-t border-ink/15 py-5">
            <p class="pt-1 font-sans text-sm text-terracotta">{y.n}</p>
            <p class="text-[18.5px] leading-[1.6] text-ink/90">{y.t}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-7 text-[19px] italic text-ink/70">
      Rule one, borrowed from every successful Baugruppe: do not buy land first.
    </p>
  </section>

  <section class="mx-auto mt-24 grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6 px-6 sm:px-12">
    <a href={withBase('/scale/')} class="border-2 border-ink bg-paper-raised px-10 py-9 no-underline">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">Then</p>
      <p class="mt-2.5 text-[26px] font-medium leading-[1.25]">One building, two, three, a block →</p>
    </a>
    <a href={withBase('/how/')} class="border-2 border-ink bg-paper-raised px-10 py-9 no-underline">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-terracotta">Practically</p>
      <p class="mt-2.5 text-[26px] font-medium leading-[1.25]">Tenure, money, code, first steps →</p>
    </a>
  </section>
</Base>
