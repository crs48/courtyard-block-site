<CaseStudy
  title="Kalkbreite"
  subtitle="Yes, the trams live downstairs."
  heroSrc="https://commons.wikimedia.org/wiki/Special:FilePath/Kalkbreite.jpg?width=1400"
  heroPlaceholder="Kalkbreite hero"
  heroCredit="Bub37 · CC BY-SA 4.0"
  heroCreditHref="https://commons.wikimedia.org/wiki/File:Kalkbreite.jpg"
