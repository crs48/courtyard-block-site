---
import CaseStudy from '../layouts/CaseStudy.astro';

const facts = [
  { k: 'City', v: 'Zürich' },
  { k: 'Year', v: '2015' },
  { k: 'Buildings', v: '13' },
  { k: 'Homes', v: '~370' },
  { k: 'Residents', v: '~1,200' },
  { k: 'Client', v: '"mehr als wohnen" co-op coalition' },
  { k: 'Site', v: 'Former concrete plant' },
];

const gallery = [
  {
    placeholder: 'Square — photo needed',
    cap: 'Hunzikerplatz — the central square between the thirteen houses',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/HAL%20014243.jpg?width=1400',
    credit: 'Haller Juliet · CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:HAL_014243.jpg',
  },
  {
    placeholder: 'House facade — photo needed',
    cap: 'The house at Genossenschaftsstrasse 13 — glazed uses at the ground floor',
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Genossenschaftsstrasse%2013.jpg?width=1400',
    credit: 'Tschubby · CC BY-SA 3.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Genossenschaftsstrasse_13.jpg',
  },
  {
    placeholder: 'Ground-floor workshop — photo needed',
    cap: "Ground-floor commons in use: the residents' swap table at Dialogweg 6",
    src: 'https://commons.wikimedia.org/wiki/Special:FilePath/Tausch-Tisch%20im%20Dialogweg%206%20im%20Dezember%202019.jpg?width=1400',
    credit: 'PizzaToast · CC BY-SA 4.0',
    creditHref: 'https://commons.wikimedia.org/wiki/File:Tausch-Tisch_im_Dialogweg_6_im_Dezember_2019.jpg',
  },
