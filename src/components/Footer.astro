---
import { withBase } from '../lib/nav';

const repoUrl = 'https://github.com/crs48/courtyard-block-site';
---

<footer
  class="mt-24 flex flex-wrap justify-between gap-6 border-t border-ink/15 px-6 py-9 font-sans text-[13px] text-ink/60 sm:px-12"
>
  <span>
    Made for curious neighbors. The Courtyard Block — an atlas and a working draft. Original text &amp; diagrams CC BY-NC;
    photos keep their own licenses.
  </span>
  <span class="flex flex-wrap gap-5">
    <a href={withBase('/about/')}>About &amp; sources</a>
    <a href={withBase('/how/')}>Propose a site</a>
    <a href={repoUrl}>Contribute on GitHub</a>
    <a href="https://crs.land/">More projects at crs.land ↗</a>
  </span>
</footer>
